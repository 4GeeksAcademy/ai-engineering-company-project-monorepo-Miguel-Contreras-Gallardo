# ═══════════════════════════════════════════════
# TrackFlow — Variables de Entorno (ejemplo)
# ═══════════════════════════════════════════════
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
#
# ⚠️ NUNCA subas .env a Git. Solo .env.example
# ═══════════════════════════════════════════════

# ────────────────────────────────────────────────
# Base de datos (PostgreSQL)
# ────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# ────────────────────────────────────────────────
# Backend (FastAPI)
# ────────────────────────────────────────────────
API_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ────────────────────────────────────────────────
# Frontend (Website + Backoffice)
# ────────────────────────────────────────────────
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001

# ────────────────────────────────────────────────
# Testing
# ────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trackflow_test